<Window x:Class="RefugeAnimauxWPF.coucheVue.ListerContacts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Liste des Contacts" Height="500" Width="1000" WindowStartupLocation="CenterScreen">
    <Grid Background="#2D5016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="👤 Liste des Contacts" Foreground="White" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>
        
        <DataGrid Grid.Row="1" Width="950" Height="350"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  Margin="10" HorizontalAlignment="Center"
                  ItemsSource="{Binding collectionContacts}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="White" AlternatingRowBackground="#E8F5E9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Identifiant}" Width="50"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="100"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Prenom}" Width="100"/>
                <DataGridTextColumn Header="GSM" Binding="{Binding Gsm}" Width="110"/>
                <DataGridTextColumn Header="Téléphone" Binding="{Binding Telephone}" Width="110"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Adresse" Binding="{Binding Adresse_contact}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Ajouter" Width="100" Margin="10,5" Click="AjoutContact_Click" Padding="10,5"/>
            <Button Content="Rafraîchir" Width="100" Margin="10,5" Click="Rafraichir_Click" Padding="10,5"/>
            <Button Content="Fermer" Width="100" Margin="10,5" Click="BFermer_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
