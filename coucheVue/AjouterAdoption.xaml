<Window x:Class="RefugeAnimauxWPF.coucheVue.AjouterAdoption"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nouvelle Demande d'Adoption" Style="{StaticResource WindowColor}" 
        Height="350" Width="450" WindowStartupLocation="CenterScreen">
    <StackPanel Orientation="Vertical" Margin="20">
        <TextBlock Text="❤️ Nouvelle Demande d'Adoption" Foreground="White" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Animal *:</TextBlock>
            <ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeAnimaux}"
                      SelectedItem="{Binding AnimalSelectionne, Mode=TwoWay}"
                      DisplayMemberPath="Nom"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Adoptant *:</TextBlock>
            <ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeContacts}"
                      SelectedItem="{Binding ContactSelectionne, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nom}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Date demande *:</TextBlock>
            <DatePicker Margin="5" Width="220" SelectedDate="{Binding DateDemande, Mode=TwoWay}"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Statut *:</TextBlock>
            <ComboBox Margin="5" Width="220" SelectedValue="{Binding Statut, Mode=TwoWay}"
                      SelectedValuePath="Content">
                <ComboBoxItem Content="demande"/>
                <ComboBoxItem Content="acceptee"/>
                <ComboBoxItem Content="rejet_environnement"/>
                <ComboBoxItem Content="rejet_comportement"/>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Margin="10" Content="Ajouter" Width="100" Padding="10,5" Click="Ajouter_Click"/>
            <Button Margin="10" Content="Fermer" Width="100" Padding="10,5" Click="Fermer_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
