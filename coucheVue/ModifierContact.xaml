<Window x:Class="RefugeAnimauxWPF.coucheVue.ModifierContact"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RefugeAnimauxWPF.coucheVue"
        mc:Ignorable="d"
        Title="Modifier un Contact" Style="{StaticResource WindowColor}" 
        Height="580" Width="450" WindowStartupLocation="CenterScreen">
	<StackPanel Orientation="Vertical" Margin="20">
		<TextBlock Text="?? Modifier un Contact" Foreground="White" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Contact *:</TextBlock>
			<ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeContacts}"
                      SelectedItem="{Binding ContactSelectionne, Mode=TwoWay}">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock>
                            <Run Text="{Binding Nom}"/><Run Text=" "/><Run Text="{Binding Prenom}"/>
						</TextBlock>
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
		</StackPanel>

		<TextBlock Text="--- Informations ---" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,8,0,5"/>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Nom *:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Prenom *:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Prenom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Registre national:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding RegistreNational, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Format: YY.MM.DD-XXX.XX"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">GSM:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Gsm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Telephone:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Telephone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Email:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<TextBlock Text="--- Adresse ---" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,8,0,5"/>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Rue *:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Rue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Code postal *:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Cp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" Margin="5">
			<TextBlock Foreground="White" Width="120" Margin="5">Localite *:</TextBlock>
			<TextBox Margin="5" Width="220" Text="{Binding Localite, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
		</StackPanel>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
			<Button Margin="10" Content="Modifier" Width="100" Padding="10,5" Click="Modifier_Click"/>
			<Button Margin="10" Content="Fermer" Width="100" Padding="10,5" Click="Fermer_Click"/>
		</StackPanel>
	</StackPanel>
</Window>