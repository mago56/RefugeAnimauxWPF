<Window x:Class="RefugeAnimauxWPF.coucheVue.ListerEntrees"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Liste des Entrées" Height="450" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Background="#2D5016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="📥 Liste des Entrées" Foreground="White" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>
        
        <DataGrid Grid.Row="1" Width="800" Height="300"
                  Margin="10" HorizontalAlignment="Center"
                  ItemsSource="{Binding collectionEntrees}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="White" AlternatingRowBackground="#E8F5E9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Animal" Binding="{Binding Animal.Nom}" Width="120"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Animal.Type}" Width="80"/>
                <DataGridTextColumn Header="Contact" Binding="{Binding Contact.Nom}" Width="120"/>
                <DataGridTextColumn Header="Prénom" Binding="{Binding Contact.Prenom}" Width="100"/>
                <DataGridTextColumn Header="Date Entrée" Binding="{Binding Date_entree, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Raison" Binding="{Binding Raison}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Ajouter" Width="100" Margin="10,5" Click="Ajouter_Click" Padding="10,5"/>
            <Button Content="Rafraîchir" Width="100" Margin="10,5" Click="Rafraichir_Click" Padding="10,5"/>
            <Button Content="Fermer" Width="100" Margin="10,5" Click="BFermer_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
