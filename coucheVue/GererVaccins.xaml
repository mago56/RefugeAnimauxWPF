<Window x:Class="RefugeAnimauxWPF.coucheVue.GererVaccins"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Gestion des Vaccins" Height="500" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Background="#2D5016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="💉 Gestion des Vaccins" Foreground="White" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>
        
        <DataGrid Grid.Row="1" Width="550" Height="250"
                  Margin="10" HorizontalAlignment="Center"
                  ItemsSource="{Binding collectionVaccins}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="White" AlternatingRowBackground="#E8F5E9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom du Vaccin" Binding="{Binding Nom}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Formulaire d'ajout -->
        <GroupBox Grid.Row="2" Header="Ajouter un Vaccin" Foreground="White" Margin="20,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <TextBlock Foreground="White" Margin="5" VerticalAlignment="Center">Nom du vaccin:</TextBlock>
                <TextBox Width="250" Margin="5" Text="{Binding NouveauVaccin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Ajouter" Width="80" Margin="10,5" Padding="5" Click="AjouterVaccin_Click"/>
            </StackPanel>
        </GroupBox>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Rafraîchir" Width="100" Margin="10,5" Click="Rafraichir_Click" Padding="10,5"/>
            <Button Content="Fermer" Width="100" Margin="10,5" Click="Fermer_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
