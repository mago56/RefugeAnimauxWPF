<Window x:Class="RefugeAnimauxWPF.coucheVue.ListerAnimaux"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Liste des Animaux" Height="500" Width="950"
        WindowStartupLocation="CenterScreen">
    <Grid Background="#2D5016">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="🐾 Liste des Animaux" 
                   Foreground="White" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,15,0,15"/>
        
        <DataGrid Grid.Row="1" Width="900" Height="350"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  Margin="10" Name="GrilleListeAnimaux" HorizontalAlignment="Center"
                  ItemsSource="{Binding collectionAnimaux}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="White" AlternatingRowBackground="#E8F5E9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Identifiant}" Width="50"/>
                <DataGridTextColumn Header="Nom" Binding="{Binding Nom}" Width="100"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                <DataGridTextColumn Header="Couleurs" Binding="{Binding Couleurs}" Width="100"/>
                <DataGridCheckBoxColumn Header="Stérilisé" Binding="{Binding Sterilise}" Width="70"/>
                <DataGridTextColumn Header="Date Naissance" Binding="{Binding Date_naissance, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Particularité" Binding="{Binding Particularite}" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Content="Ajouter" Width="100" Margin="10,5" Click="AjoutAnimal_Click" Padding="10,5"/>
            <Button Content="Rafraîchir" Width="100" Margin="10,5" Click="Rafraichir_Click" Padding="10,5"/>
            <Button Content="Fermer" Width="100" Margin="10,5" Click="BFermer_Click" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
