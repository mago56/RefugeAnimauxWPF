<Window x:Class="RefugeAnimauxWPF.coucheVue.AjouterEntree"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Nouvelle Entrée" Style="{StaticResource WindowColor}" 
        Height="350" Width="450" WindowStartupLocation="CenterScreen">
    <StackPanel Orientation="Vertical" Margin="20">
        <TextBlock Text="📥 Nouvelle Entrée" Foreground="White" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Animal *:</TextBlock>
            <ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeAnimaux}"
                      SelectedItem="{Binding AnimalSelectionne, Mode=TwoWay}"
                      DisplayMemberPath="Nom"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Contact *:</TextBlock>
            <ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeContacts}"
                      SelectedItem="{Binding ContactSelectionne, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Nom}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Date entrée *:</TextBlock>
            <DatePicker Margin="5" Width="220" SelectedDate="{Binding DateEntree, Mode=TwoWay}"/>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Raison *:</TextBlock>
			<ComboBox Margin="5" Width="220" SelectedValue="{Binding Raison, Mode=TwoWay}"
          SelectedValuePath="Content">
				<ComboBoxItem Content="abandon"/>
				<ComboBoxItem Content="errant"/>
				<ComboBoxItem Content="deces_proprietaire"/>
				<ComboBoxItem Content="saisie"/>
				<ComboBoxItem Content="retour_adoption"/>
				<ComboBoxItem Content="retour_famille_accueil"/>
			</ComboBox>
        </StackPanel>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Margin="10" Content="Ajouter" Width="100" Padding="10,5" Click="Ajouter_Click"/>
            <Button Margin="10" Content="Fermer" Width="100" Padding="10,5" Click="Fermer_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
