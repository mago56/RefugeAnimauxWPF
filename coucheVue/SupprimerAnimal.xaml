<Window x:Class="RefugeAnimauxWPF.coucheVue.SupprimerAnimal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Supprimer un Animal" Style="{StaticResource WindowColor}" 
        Height="350" Width="450" WindowStartupLocation="CenterScreen">
    <StackPanel Orientation="Vertical" Margin="20">
        <TextBlock Text=" Supprimer un Animal" Foreground="White" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" Margin="5">
            <TextBlock Foreground="White" Width="120" Margin="5">Animal *:</TextBlock>
            <ComboBox Margin="5" Width="220" ItemsSource="{Binding ListeAnimaux}"
                      SelectedItem="{Binding AnimalSelectionne, Mode=TwoWay}"
                      DisplayMemberPath="Nom"/>
        </StackPanel>

        

        

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Margin="10" Content="Supprimer" Width="100" Padding="10,5" Click="Supprimer_Click"/>
            <Button Margin="10" Content="Fermer" Width="100" Padding="10,5" Click="Fermer_Click"/>
        </StackPanel>
    </StackPanel>
</Window>